<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProductInventoryTestApp.Pages.ProductPage" 
             Title="Termék adatlapja">

    <Grid
    ColumnDefinitions="120,*"
    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
    Margin="10,10,0,10"
    RowSpacing="10"  
    ColumnSpacing="10">
        <CollectionView 
            Grid.Row="0"
            Grid.ColumnSpan="2"
            ItemsSource="{Binding ErrorMessages}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label
                Text="{Binding}"
                TextColor="Red"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="1"
           Grid.Column="0"
           Text="Id:" />

        <Label Grid.Row="1"
           Grid.Column="1"
           Text="{Binding CurrentProduct.Id}" />

        <Label Grid.Row="2"
           Grid.Column="0"
           Text="Név:" />

        <Entry Grid.Row="2"
           Grid.Column="1"
           Text="{Binding CurrentProduct.Name}" />

        <Label Grid.Row="3"
           Grid.Column="0"
           Text="Vonalkód:" />

        <Entry Grid.Row="3"
           Grid.Column="1"
           Text="{Binding CurrentProduct.Barcode}" />

        <Label Grid.Row="4"
           Grid.Column="0"
           Text="Ár:" />

        <Entry Grid.Row="4"
           Grid.Column="1"
           Keyboard="Numeric"    
           Text="{Binding PriceText}" />

        <Label Grid.Row="5"
           Grid.Column="0"
           Text="Készlet:" />

        <Entry Grid.Row="5"
           Grid.Column="1"
           Keyboard="Numeric"    
           Text="{Binding QuantityText}"/>

        <HorizontalStackLayout
            Grid.Row="6"
            Grid.ColumnSpan="2"
            HorizontalOptions="Start"
            Spacing="10">

            <Button Text="Mentés"
                    Command="{Binding SaveCommand}"/>


            <Button Text="Mégsem"
                    Command="{Binding CancelCommand}"/>
        </HorizontalStackLayout>
    </Grid>

</ContentPage>